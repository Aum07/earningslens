# Copy to .env and fill in. Never commit .env.
# No quotes around values: Spring reads this file as a properties file.

OPENAI_API_KEY=
SEC_USER_AGENT=Your Name your.email@example.com

# Local Docker database (these match the defaults)
DB_NAME=earningslens
DB_USER=earningslens
DB_PASSWORD=earningslens
DB_URL=jdbc:postgresql://localhost:5432/earningslens
